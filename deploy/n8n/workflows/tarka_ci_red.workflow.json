{
  "name": "Tarka Master CI Red",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Hong_Kong"
  },
  "meta": {
    "description": "Weekdays every 30m 09:00–19:00 HKT: check_tarka_master_ci.sh. Alerts on failure (includes stdout/URL); green is silent. No auto-fix."
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/30 9-19 * * 1-5"
            }
          ]
        }
      },
      "id": "tarka-sched",
      "name": "Weekdays every 30m 09-19 HKT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "command": "bash \"$OCTO_SPORK_ROOT/deploy/n8n/scripts/check_tarka_master_ci.sh\""
      },
      "id": "tarka-run",
      "name": "Check tarka master CI",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [460, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "tarka-exit-eq-0",
              "leftValue": "={{ $json.exitCode }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "tarka-if",
      "name": "IF exit 0",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "command": "bash \"$OCTO_SPORK_ROOT/deploy/n8n/scripts/wa_send.sh\" --channel alerts --text \"tarka master CI red: {{$json.stdout}}\""
      },
      "id": "tarka-alerts",
      "name": "Send Alerts",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [940, 420]
    }
  ],
  "connections": {
    "Weekdays every 30m 09-19 HKT": {
      "main": [[{ "node": "Check tarka master CI", "type": "main", "index": 0 }]]
    },
    "Check tarka master CI": {
      "main": [[{ "node": "IF exit 0", "type": "main", "index": 0 }]]
    },
    "IF exit 0": {
      "main": [
        [],
        [{ "node": "Send Alerts", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
  "versionId": "1"
}
