{
  "name": "Hermes Finance Brief",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Hong_Kong"
  },
  "meta": {
    "description": "07:00 HKT: run_hermes_brief.sh finance → Briefs on success, Alerts on failure. Scripts stay the truth."
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "finance-sched",
      "name": "Daily 07:00 HKT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "command": "bash \"$OCTO_SPORK_ROOT/deploy/n8n/scripts/run_hermes_brief.sh\" finance"
      },
      "id": "finance-run",
      "name": "Run finance brief",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [460, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "finance-exit-eq-0",
              "leftValue": "={{ $json.exitCode }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "finance-if",
      "name": "IF exit 0",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "command": "bash \"$OCTO_SPORK_ROOT/deploy/n8n/scripts/wa_send.sh\" --channel briefs --file \"$HERMES_FINANCE_ROOT/briefs/$(date +%F).md\""
      },
      "id": "finance-briefs",
      "name": "Send Briefs",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [940, 200]
    },
    {
      "parameters": {
        "command": "bash \"$OCTO_SPORK_ROOT/deploy/n8n/scripts/wa_send.sh\" --channel alerts --text \"finance brief failed\""
      },
      "id": "finance-alerts",
      "name": "Send Alerts",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [940, 420]
    }
  ],
  "connections": {
    "Daily 07:00 HKT": {
      "main": [[{ "node": "Run finance brief", "type": "main", "index": 0 }]]
    },
    "Run finance brief": {
      "main": [[{ "node": "IF exit 0", "type": "main", "index": 0 }]]
    },
    "IF exit 0": {
      "main": [
        [{ "node": "Send Briefs", "type": "main", "index": 0 }],
        [{ "node": "Send Alerts", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
  "versionId": "1"
}
